# ============================================================
# Lanka Pay – Environment Variables (example / template)
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ------ Firebase / Firestore --------------------------------
FIREBASE_PROJECT_ID=lankapay-dev
FIREBASE_CREDENTIALS_PATH=
FIRESTORE_EMULATOR_HOST=localhost:8085

# ------ JWT -------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_BASE64_SECRET
JWT_EXPIRY_MINUTES=30

# ------ OTP -------------------------------------------------
# TEST  = OTPs are printed to the log (no real SMS sent)
# PROD  = Real SMS gateway is used
OTP_MODE=TEST
OTP_EXPIRY_SECONDS=300

# ------ SMS gateway (only used when OTP_MODE=PROD) ----------
SMS_API_URL=https://api.example-sms-provider.com/send
SMS_API_KEY=REPLACE_WITH_SMS_API_KEY

# ------ Application -----------------------------------------
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# ------ Simulated bank adapter ------------------------------
# Keeps the simulated bank adapter enabled in all non-prod envs
BANK_ADAPTER_MODE=SIMULATED

# ------ Encryption ------------------------------------------
# AES-256-GCM key for encrypting bank account references at rest.
# Generate: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
BANK_ACCOUNT_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64URL_KEY
